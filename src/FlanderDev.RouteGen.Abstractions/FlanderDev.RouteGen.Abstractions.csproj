<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>0.2.8</Version>
		<Authors>FlanderDev</Authors>
		<Description>Attributes and runtime support types (ApiException, HTTP verb attributes, ApiRoute, Query/Body/Route markers) for RouteGen, a Roslyn source generator that keeps Blazor WebAssembly client calls and ASP.NET Core MVC controller routes generated from a single shared interface.</Description>
		<PackageTags>roslyn;source-generator;blazor;aspnetcore;routing;codegen</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/FlanderDev/RouteGen</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\"/>
	</ItemGroup>
</Project>
